# Copy this file to .env.local (local dev) or set these as environment
# variables in your hosting platform's dashboard (Fly.io: fly secrets set ...).

# Required in production — any long random string. Used to sign the admin
# login session cookie. Generate one with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# Where the SQLite database file lives. Defaults to ./data/ibc.db if unset.
# On Fly.io/Railway/Render, point this at your persistent volume's mount
# path, e.g.
# DATABASE_PATH=/data/ibc.db
# DATABASE_PATH=./data/ibc.db

# Absolute base URL of the live site. Emails cannot use relative paths or
# data: URIs — Gmail strips them — so the crest, player photos and every
# link in the newsletter are built from this. Defaults to
# https://internationalbc.fly.dev if unset.
SITE_URL=https://internationalbc.fly.dev

# --- Email over SMTP (newsletter, Monday reminder, access-request approvals) ---
# Any mailbox works: Gmail (use an "app password", not your normal
# password), Infomaniak, your own domain's mail provider, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=International Basketball Club Genève <no-reply@international-bc-geneve.local>
CLUB_EMAIL=contact@international-bc-geneve.ch

# --- WhatsApp reminders (optional) ---
# Sign up at https://www.twilio.com, enable the WhatsApp sandbox (free, for
# testing) or an approved WhatsApp Business sender (for production), and
# paste the values from your Twilio console below. Leave blank to skip
# WhatsApp — the app runs fine without it (email-only reminders).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- "Sign in with Google" (admin accounts only) ---
# 1. console.cloud.google.com -> create a project -> "OAuth consent screen"
#    (External, publish it) -> "Credentials" -> "Create OAuth client ID"
#    (type: Web application).
# 2. Authorized redirect URI: https://your-domain/api/auth/google/callback
#    (must match GOOGLE_REDIRECT_URI below exactly, or the default if unset).
# 3. Paste the Client ID and Client Secret below.
# This does NOT create accounts — it only lets someone log into an admin
# account that already exists and shares the same email address.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Usually not needed — defaults to https://your-domain/api/auth/google/callback
# GOOGLE_REDIRECT_URI=https://your-domain/api/auth/google/callback

# Shared secret protecting BOTH cron routes from being called by anyone but
# your scheduler:
#   /api/cron/weekly-reminder   — Monday reminder to players
#   /api/cron/weekly-newsletter — builds the week's newsletter drafts
# One secret covers both. Generate one with: openssl rand -hex 16
CRON_SECRET=
