# Copy this file to .env.local (local dev) or set these as environment
# variables in your hosting platform's dashboard (Fly.io: fly secrets set ...).

# Required in production — any long random string. Used to sign the admin
# login session cookie. Generate one with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# Where the SQLite database file lives. Defaults to ./data/ibc.db if unset.
# On Fly.io/Railway/Render, point this at your persistent volume's mount
# path, e.g.
# DATABASE_PATH=/data/ibc.db
# DATABASE_PATH=./data/ibc.db

# --- Email over SMTP (Monday reminder, access-request approvals) ---
# Any mailbox works: Gmail (use an "app password", not your normal
# password), Infomaniak, your own domain's mail provider, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=International Basketball Club Genève <no-reply@international-bc-geneve.local>
CLUB_EMAIL=contact@international-bc-geneve.ch

# --- WhatsApp reminders (optional) ---
# Sign up at https://www.twilio.com, enable the WhatsApp sandbox (free, for
# testing) or an approved WhatsApp Business sender (for production), and
# paste the values from your Twilio console below. Leave blank to skip
# WhatsApp — the app runs fine without it (email-only reminders).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Shared secret to protect /api/cron/weekly-reminder from being called by
# anyone but your scheduler. Generate one with: openssl rand -hex 16
CRON_SECRET=
