# Copy this file to .env.local (local dev) or set these as environment
# variables in your hosting platform's dashboard (Railway, Render, etc.).

# Required in production — any long random string. Used to sign the admin
# login session cookie. Generate one with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# Where the SQLite database file lives. Defaults to ./data/ibc.db if unset.
# On Railway/Render, point this at your persistent volume's mount path, e.g.
# DATABASE_PATH=/data/ibc.db
# DATABASE_PATH=./data/ibc.db

# --- Email (Monday reminder + any future notifications) ---
# Sign up free at https://resend.com, verify your sending domain (or use
# their onboarding@resend.dev sandbox address while testing), and paste the
# API key below.
RESEND_API_KEY=
FROM_EMAIL=International Basketball Club Genève <onboarding@resend.dev>
CLUB_EMAIL=contact@international-bc-geneve.ch

# Shared secret to protect /api/cron/weekly-reminder from being called by
# anyone but your scheduler. Generate one with: openssl rand -hex 16
CRON_SECRET=
